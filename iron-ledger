<script>
/* ==========================================================================
   IRON LEDGER — app logic (vanilla JS, no build step)
   State lives in memory; persist()/load() sync it to localStorage so data
   survives closing the browser. Two keys are used:
     ironledger.routines  -> array of routines
     ironledger.entries   -> { "YYYY-MM-DD": entry } journal log
   ========================================================================== */

const STORAGE_ROUTINES = 'ironledger.routines';
const STORAGE_ENTRIES  = 'ironledger.entries';

let state = {
  tab: 'log',
  routines: [],
  entries: {},
  selectedDate: new Date(),
  draft: null,
  editingRoutineId: null,
  saveFlash: false,
  showIntro: false,
};

const STORAGE_SEEDED = 'ironledger.seeded';
const STORAGE_DISMISSED_INTRO = 'ironledger.dismissedIntro';

// First time the app is ever opened (nothing in storage yet), drop in one
// example routine so buyers see how it works instead of a blank screen.
function seedSampleDataIfFirstRun() {
  if (localStorage.getItem(STORAGE_SEEDED)) return;
  localStorage.setItem(STORAGE_SEEDED, '1');
  if (state.routines.length === 0) {
    state.routines.push({
      id: newId(),
      name: 'Example: Push Day (edit or delete me)',
      exercises: [
        { id: newId(), name: 'Bench Press', sets: 4, reps: '6-8', weight: '135lb' },
        { id: newId(), name: 'Overhead Press', sets: 3, reps: '8-10', weight: '65lb' },
        { id: newId(), name: 'Push-ups', sets: 3, reps: '12-15', weight: '' },
      ],
    });
    saveRoutines();
  }
  state.showIntro = true;
}
function dismissIntro() {
  state.showIntro = false;
  localStorage.setItem(STORAGE_DISMISSED_INTRO, '1');
  render();
}

// ---------- persistence ----------
function loadState() {
  try { state.routines = JSON.parse(localStorage.getItem(STORAGE_ROUTINES)) || []; }
  catch (e) { state.routines = []; }
  try { state.entries = JSON.parse(localStorage.getItem(STORAGE_ENTRIES)) || {}; }
  catch (e) { state.entries = {}; }
}
function saveRoutines() { localStorage.setItem(STORAGE_ROUTINES, JSON.stringify(state.routines)); }
function saveEntries()  { localStorage.setItem(STORAGE_ENTRIES, JSON.stringify(state.entries)); }

// ---------- helpers ----------
function pad(n){ return String(n).padStart(2,'0'); }
function toDateStr(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate()); }
function fromDateStr(s){ const [y,m,d]=s.split('-').map(Number); return new Date(y,m-1,d); }
function prettyDate(d){ return d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'}); }
function newId(){ return Math.random().toString(36).slice(2,10); }
function esc(str){ return (str==null?'':String(str)).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function currentDateStr(){ return toDateStr(state.selectedDate); }

function syncDraftToSelectedDate() {
  const ds = currentDateStr();
  state.draft = state.entries[ds] ? JSON.parse(JSON.stringify(state.entries[ds])) : null;
}

// ---------- tab switching ----------
function setTab(t) {
  state.tab = t;
  render();
}

// ---------- routine editing (Plan tab) ----------
function addRoutine() {
  const r = { id: newId(), name: 'New Routine', exercises: [] };
  state.routines.push(r);
  state.editingRoutineId = r.id;
  saveRoutines();
  render();
}
function toggleEditRoutine(id) {
  state.editingRoutineId = state.editingRoutineId === id ? null : id;
  render();
}
function updateRoutineName(id, value) {
  const r = state.routines.find(r => r.id === id);
  if (r) r.name = value;
  saveRoutines();
}
function deleteRoutine(id) {
  state.routines = state.routines.filter(r => r.id !== id);
  if (state.editingRoutineId === id) state.editingRoutineId = null;
  saveRoutines();
  render();
}
function addExerciseToRoutine(routineId) {
  const r = state.routines.find(r => r.id === routineId);
  if (!r) return;
  r.exercises.push({ id: newId(), name: 'New exercise', sets: 3, reps: '8-10', weight: '' });
  saveRoutines();
  render();
}
function updateExerciseField(routineId, exId, field, value) {
  const r = state.routines.find(r => r.id === routineId);
  if (!r) return;
  const ex = r.exercises.find(e => e.id === exId);
  if (ex) ex[field] = value;
  saveRoutines();
}
function removeExerciseFromRoutine(routineId, exId) {
  const r = state.routines.find(r => r.id === routineId);
  if (!r) return;
  r.exercises = r.exercises.filter(e => e.id !== exId);
  saveRoutines();
  render();
}

// ---------- journal / draft (Log tab) ----------
function shiftDate(delta) {
  const d = new Date(state.selectedDate);
  d.setDate(d.getDate() + delta);
  state.selectedDate = d;
  syncDraftToSelectedDate();
  render();
}
function startFromRoutine(routineId) {
  const r = state.routines.find(r => r.id === routineId);
  if (!r) return;
  state.draft = {
    date: currentDateStr(),
    routineId: r.id,
    routineName: r.name,
    exercises: r.exercises.map(ex => ({
      id: newId(),
      name: ex.name,
      sets: Array.from({ length: Number(ex.sets) || 1 }, () => ({ reps: ex.reps || '', weight: ex.weight || '', done: false })),
    })),
  };
  render();
}
function startFreeEntry() {
  state.draft = {
    date: currentDateStr(),
    routineId: null,
    routineName: null,
    exercises: [{ id: newId(), name: '', sets: [{ reps: '', weight: '', done: false }] }],
  };
  render();
}
function draftAddExercise() {
  state.draft.exercises.push({ id: newId(), name: '', sets: [{ reps: '', weight: '', done: false }] });
  render();
}
function draftUpdateExerciseName(exId, value) {
  const ex = state.draft.exercises.find(e => e.id === exId);
  if (ex) ex.name = value;
}
function draftRemoveExercise(exId) {
  state.draft.exercises = state.draft.exercises.filter(e => e.id !== exId);
  render();
}
function draftAddSet(exId) {
  const ex = state.draft.exercises.find(e => e.id === exId);
  if (ex) ex.sets.push({ reps: '', weight: '', done: false });
  render();
}
function draftUpdateSetField(exId, idx, field, value) {
  const ex = state.draft.exercises.find(e => e.id === exId);
  if (ex && ex.sets[idx]) ex.sets[idx][field] = value;
}
function draftToggleSetDone(exId, idx) {
  const ex = state.draft.exercises.find(e => e.id === exId);
  if (ex && ex.sets[idx]) ex.sets[idx].done = !ex.sets[idx].done;
  render();
}
function draftRemoveSet(exId, idx) {
  const ex = state.draft.exercises.find(e => e.id === exId);
  if (ex) ex.sets = ex.sets.filter((_, i) => i !== idx);
  render();
}
function saveDay() {
  state.entries[currentDateStr()] = state.draft;
  saveEntries();
  state.saveFlash = true;
  render();
  setTimeout(() => { state.saveFlash = false; render(); }, 1400);
}
function clearDay() {
  delete state.entries[currentDateStr()];
  saveEntries();
  state.draft = null;
  render();
}
function jumpToDate(ds) {
  state.selectedDate = fromDateStr(ds);
  syncDraftToSelectedDate();
  render();
}
function summarizeEntry(entry) {
  if (!entry) return '';
  const exCount = entry.exercises.length;
  const setsTotal = entry.exercises.reduce((a, ex) => a + ex.sets.length, 0);
  const setsDone = entry.exercises.reduce((a, ex) => a + ex.sets.filter(s => s.done).length, 0);
  return exCount + ' ex &middot; ' + setsDone + '/' + setsTotal + ' sets';
}

// ---------- render ----------
function render() {
  document.getElementById('tab-plan').className = 'tab-btn' + (state.tab === 'plan' ? ' active' : '');
  document.getElementById('tab-log').className = 'tab-btn' + (state.tab === 'log' ? ' active' : '');
  const app = document.getElementById('app');
  let banner = '';
  if (state.showIntro) {
    banner = '<div class="intro-banner">' +
      '<button class="intro-close" onclick="dismissIntro()">&times;</button>' +
      '<b>New here?</b> We added an example routine so you can see how this works. ' +
      'Try the <b>Log</b> tab and tap it to fill in a workout, or head to <b>Plan</b> to build your own and delete the example.' +
      '</div>';
  }
  app.innerHTML = banner + (state.tab === 'plan' ? renderPlanTab() : renderLogTab());
}

function renderPlanTab() {
  let html = '';
  html += '<div class="row-between" style="margin-bottom:12px;">';
  html += '<span class="mono" style="font-size:12px;text-transform:uppercase;color:var(--ink-muted);">' + state.routines.length + ' routine' + (state.routines.length===1?'':'s') + '</span>';
  html += '<button class="btn-dashed" style="background:var(--brass);color:#1A1608;border:none;" onclick="addRoutine()">+ New routine</button>';
  html += '</div>';

  if (state.routines.length === 0) {
    html += '<div class="card empty-state muted">No routines yet. Build one so you can pull it straight into a day\'s log.</div>';
  }

  html += '<div class="stack">';
  state.routines.forEach(r => {
    const isEditing = state.editingRoutineId === r.id;
    html += '<div class="card">';
    html += '<div class="row-between">';
    if (isEditing) {
      html += '<input class="field-name display" style="font-size:22px;" value="' + esc(r.name) + '" oninput="updateRoutineName(\'' + r.id + '\', this.value)">';
    } else {
      html += '<h3 class="display" style="font-size:22px;margin:0;">' + esc(r.name) + '</h3>';
    }
    html += '<div style="display:flex;gap:8px;flex-shrink:0;">';
    html += '<button class="btn-text mono" style="color:var(--brass);font-size:11px;text-transform:uppercase;" onclick="toggleEditRoutine(\'' + r.id + '\')">' + (isEditing ? 'Done' : 'Edit') + '</button>';
    html += '<button class="btn-text mono" style="color:var(--rust);font-size:11px;text-transform:uppercase;" onclick="deleteRoutine(\'' + r.id + '\')">Delete</button>';
    html += '</div></div>';

    html += '<div class="mono muted" style="font-size:12px;margin-top:4px;">' + r.exercises.length + ' exercise' + (r.exercises.length===1?'':'s') + '</div>';

    if (isEditing) {
      html += '<div class="stack" style="margin-top:10px;">';
      r.exercises.forEach(ex => {
        html += '<div style="display:flex;gap:8px;align-items:center;">';
        html += '<input class="field" style="flex:1;text-align:left;" placeholder="Exercise" value="' + esc(ex.name) + '" oninput="updateExerciseField(\'' + r.id + '\',\'' + ex.id + '\',\'name\',this.value)">';
        html += '<input class="field" style="width:44px;" placeholder="sets" value="' + esc(ex.sets) + '" oninput="updateExerciseField(\'' + r.id + '\',\'' + ex.id + '\',\'sets\',this.value)">';
        html += '<input class="field" style="width:60px;" placeholder="reps" value="' + esc(ex.reps) + '" oninput="updateExerciseField(\'' + r.id + '\',\'' + ex.id + '\',\'reps\',this.value)">';
        html += '<input class="field" style="width:52px;" placeholder="wt" value="' + esc(ex.weight) + '" oninput="updateExerciseField(\'' + r.id + '\',\'' + ex.id + '\',\'weight\',this.value)">';
        html += '<button class="x-btn" onclick="removeExerciseFromRoutine(\'' + r.id + '\',\'' + ex.id + '\')">&times;</button>';
        html += '</div>';
      });
      html += '<button class="btn-dashed" style="align-self:flex-start;margin-top:2px;" onclick="addExerciseToRoutine(\'' + r.id + '\')">+ Add exercise</button>';
      html += '</div>';
    } else if (r.exercises.length > 0) {
      html += '<ul class="muted" style="margin:8px 0 0;padding-left:18px;font-size:14px;">';
      r.exercises.forEach(ex => {
        html += '<li>' + esc(ex.name) + ' <span class="mono" style="font-size:12px;">&mdash; ' + esc(ex.sets) + '&times;' + esc(ex.reps) + (ex.weight ? ' @ ' + esc(ex.weight) : '') + '</span></li>';
      });
      html += '</ul>';
    }
    html += '</div>';
  });
  html += '</div>';
  return html;
}

function renderLogTab() {
  const ds = currentDateStr();
  const hasSavedEntry = !!state.entries[ds];
  let html = '';

  html += '<div class="date-row">';
  html += '<button onclick="shiftDate(-1)">&larr;</button>';
  html += '<div class="date-label">';
  html += '<div class="display">' + prettyDate(state.selectedDate) + '</div>';
  if (hasSavedEntry) html += '<div class="stamp">Logged</div>';
  html += '</div>';
  html += '<button onclick="shiftDate(1)">&rarr;</button>';
  html += '</div>';

  if (!state.draft) {
    html += '<div class="stack">';
    html += '<div class="card empty-state muted">Nothing logged for this day yet.</div>';
    if (state.routines.length > 0) {
      html += '<div class="section-label">Start from a routine</div>';
      state.routines.forEach(r => {
        html += '<button class="history-item" style="margin-bottom:6px;" onclick="startFromRoutine(\'' + r.id + '\')">' +
          '<span>' + esc(r.name) + '</span><span class="mono muted" style="font-size:12px;">(' + r.exercises.length + ' exercises)</span></button>';
      });
    }
    html += '<button class="btn-dashed" onclick="startFreeEntry()">+ Free-form entry</button>';
    html += '</div>';
  } else {
    html += '<div class="stack">';
    if (state.draft.routineName) {
      html += '<div class="mono muted" style="font-size:12px;text-transform:uppercase;">from routine: ' + esc(state.draft.routineName) + '</div>';
    }
    state.draft.exercises.forEach(ex => {
      html += '<div class="card">';
      html += '<div class="row-between" style="margin-bottom:8px;">';
      html += '<input class="field-name display" style="font-size:19px;" placeholder="Exercise name" value="' + esc(ex.name) + '" oninput="draftUpdateExerciseName(\'' + ex.id + '\',this.value)">';
      html += '<button class="x-btn" onclick="draftRemoveExercise(\'' + ex.id + '\')">&times;</button>';
      html += '</div>';

      ex.sets.forEach((s, i) => {
        html += '<div class="set-row">';
        html += '<span class="idx">' + (i + 1) + '</span>';
        html += '<input class="field" placeholder="reps" value="' + esc(s.reps) + '" oninput="draftUpdateSetField(\'' + ex.id + '\',' + i + ',\'reps\',this.value)">';
        html += '<span class="mono muted" style="font-size:12px;">&times;</span>';
        html += '<input class="field weight" placeholder="weight" value="' + esc(s.weight) + '" oninput="draftUpdateSetField(\'' + ex.id + '\',' + i + ',\'weight\',this.value)">';
        html += '<button class="mark-btn' + (s.done ? ' done' : '') + '" onclick="draftToggleSetDone(\'' + ex.id + '\',' + i + ')">' + (s.done ? '&check; done' : 'mark') + '</button>';
        html += '<button class="x-btn" onclick="draftRemoveSet(\'' + ex.id + '\',' + i + ')">&times;</button>';
        html += '</div>';
      });
      html += '<button class="btn-text mono" style="color:var(--brass);font-size:11px;text-transform:uppercase;margin-top:4px;" onclick="draftAddSet(\'' + ex.id + '\')">+ Set</button>';
      html += '</div>';
    });

    html += '<button class="btn-dashed" onclick="draftAddExercise()">+ Add exercise</button>';
    html += '<div style="display:flex;gap:8px;margin-top:4px;">';
    html += '<button class="btn-primary" style="flex:1;" onclick="saveDay()">' + (state.saveFlash ? 'Saved &check;' : 'Save day') + '</button>';
    html += '<button class="btn-ghost" onclick="clearDay()">Clear</button>';
    html += '</div>';
    html += '</div>';
  }

  const historyDates = Object.keys(state.entries).sort((a, b) => (a < b ? 1 : -1));
  if (historyDates.length > 0) {
    html += '<div style="margin-top:32px;">';
    html += '<div class="section-label">History</div>';
    html += '<div class="stack" style="gap:4px;">';
    historyDates.slice(0, 14).forEach(hds => {
      html += '<button class="history-item" onclick="jumpToDate(\'' + hds + '\')">' +
        '<span>' + prettyDate(fromDateStr(hds)) + '</span>' +
        '<span class="mono muted" style="font-size:12px;">' + summarizeEntry(state.entries[hds]) + '</span></button>';
    });
    html += '</div></div>';
  }

  return html;
}

// ---------- init ----------
loadState();
seedSampleDataIfFirstRun();
syncDraftToSelectedDate();
render();
</script>
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('sw.js').catch(() => {});
    });
  }
</script>
</body>
