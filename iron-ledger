<body>

<div class="wrap">
  <div>
    <h1 class="title display">IRON LEDGER</h1>
    <p class="tagline mono">Plan &rarr; Lift &rarr; Log</p>
  </div>

  <div class="tabs">
    <button class="tab-btn" id="tab-plan" onclick="setTab('plan')">Plan</button>
    <button class="tab-btn" id="tab-log" onclick="setTab('log')">Log</button>
  </div>

  <div id="app"></div>
